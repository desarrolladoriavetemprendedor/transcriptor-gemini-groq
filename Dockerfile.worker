FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1
WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg \
    && rm -rf /var/lib/apt/lists/*

COPY worker_largos_requirements.txt .
RUN pip install --no-cache-dir -r worker_largos_requirements.txt

COPY worker_largos.py .
CMD ["python", "worker_largos.py", "--poll", "10"]
