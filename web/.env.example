# Copia este archivo como .env.local y reemplaza los valores.
# Nunca uses NEXT_PUBLIC_ para estas claves.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
GROQ_API_KEY=
GROQ_MODEL=whisper-large-v3-turbo
TRANSCRIPTION_LANGUAGE=es
GROQ_FRAGMENT_SECONDS=600

# Límite del endpoint directo de Vercel. Los archivos grandes irán por el worker de Drive.
DIRECT_TRANSCRIPTION_MAX_BYTES=4194304

# Se usarán cuando conectemos persistencia, Drive y Vercel Blob.
# Credenciales OAuth de Google Drive para la subida desde la web.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_PARENT_FOLDER_ID=

GOOGLE_DRIVE_FOLDER_ID=
BLOB_READ_WRITE_TOKEN=
DATABASE_URL=
